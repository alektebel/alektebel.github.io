        { "file": "partitioning.py", "title": "strategy 3: fixed partitions" },
        { "file": "vector_clock.py", "title": "clock ordering and merge" },
        { "file": "vector_clock.py", "title": "reconciliation (paper Figure 3)" },
        { "file": "vector_clock.py", "title": "clock truncation" },
        { "file": "quorum.py", "title": "storage node keeps siblings" },
        { "file": "quorum.py", "title": "N/R/W put and get" },
        { "file": "quorum.py", "title": "siblings and read repair" },
        { "file": "hinted_handoff.py", "title": "sloppy quorum writes a hint" },
        { "file": "hinted_handoff.py", "title": "hinted handoff delivery" },
        { "file": "merkle_sync.py", "title": "merkle tree build and diff" },
        { "file": "merkle_sync.py", "title": "anti-entropy is a union" },
