{
  "repo": "alektebel/learn-stuff-from-scratch",
  "ref": "main",
  "tracks": [
    {
      "id": "aws",
      "title": "AWS from scratch",
      "tagline": "8 services, 18 graded checks",
      "dir": "aws-from-scratch",
      "blurb": "Implement the eight mechanism families every AWS service is made from — IAM policy evaluation, object storage, leased queues, partitioned KV, ephemeral compute, fanout, envelope encryption and networking — and reproduce the failure each one is famous for.",
      "files": ["iam.py", "s3.py", "sqs.py", "dynamodb.py", "lambda_svc.py", "sns.py", "kms.py", "vpc.py", "capstone.py"],
      "entry": "check.py",
      "checks": [
        { "file": "iam.py", "title": "explicit deny > allow > implicit deny" },
        { "file": "iam.py", "title": "conditions and permissions boundaries" },
        { "file": "iam.py", "title": "STS assume-role: both directions" },
        { "file": "s3.py", "title": "objects, ETags and multipart" },
        { "file": "s3.py", "title": "prefix listing and delete markers" },
        { "file": "sqs.py", "title": "visibility timeout and redelivery" },
        { "file": "sqs.py", "title": "dead letters, FIFO and dedup" },
        { "file": "dynamodb.py", "title": "composite keys, query, conditions" },
        { "file": "dynamodb.py", "title": "capacity, hot partitions, scan cost" },
        { "file": "lambda_svc.py", "title": "cold starts and warm state" },
        { "file": "lambda_svc.py", "title": "concurrency, reservations, async retry" },
        { "file": "sns.py", "title": "fanout and filter policies" },
        { "file": "sns.py", "title": "EventBridge pattern matching" },
        { "file": "kms.py", "title": "envelope encryption" },
        { "file": "kms.py", "title": "encryption context and rotation" },
        { "file": "vpc.py", "title": "CIDR, subnets and longest-prefix routing" },
        { "file": "vpc.py", "title": "stateful SG vs stateless NACL" },
        { "file": "capstone.py", "title": "the pipeline, and its failures" }
      ]
    },
    {
      "id": "compiler",
      "title": "Compiler + virtual GPU",
      "tagline": "one ISA, two machines, 12 graded checks",
      "dir": "compiler-and-vgpu",
      "blurb": "Build a 32-bit ISA, a two-pass assembler, a CPU, a recursive-descent front end, code generation with register allocation and spilling, and a SIMT warp that punishes you for branching — then compile one program to both.",
      "files": ["isa.py", "assembler.py", "cpu.py", "frontend.py", "codegen.py", "vgpu.py", "capstone.py"],
      "entry": "check.py",
      "checks": [
        { "file": "isa.py", "title": "instruction encoding round-trip" },
        { "file": "assembler.py", "title": "two-pass assembly with labels" },
        { "file": "cpu.py", "title": "arithmetic, comparison, memory" },
        { "file": "cpu.py", "title": "control flow and error reporting" },
        { "file": "frontend.py", "title": "lexer and keywords" },
        { "file": "frontend.py", "title": "parser: precedence and blocks" },
        { "file": "codegen.py", "title": "v1-v2: expressions and control flow" },
        { "file": "codegen.py", "title": "v3: allocation and spilling" },
        { "file": "vgpu.py", "title": "uniform SIMT execution" },
        { "file": "vgpu.py", "title": "v4: divergence, nesting, ragged loops" },
        { "file": "vgpu.py", "title": "barrier deadlock and disagreeing branches" },
        { "file": "capstone.py", "title": "one program, two machines" }
      ]
    },
    {
      "id": "llm",
      "title": "LLM from scratch",
      "tagline": "BPE, attention, sampling, KV cache, RoPE",
      "dir": "llm-from-scratch",
      "blurb": "The five mechanisms a language model is assembled from, in pure standard-library Python. Implement byte-pair encoding, stable softmax attention, top-p sampling, an exact KV cache and rotary positions — and see the number each one produces.",
      "files": ["tokenizer.py", "attention.py", "sampling.py", "kv_cache.py", "rope.py"],
      "entry": "check.py",
      "checks": [
        { "file": "tokenizer.py", "title": "pair counts and non-overlapping merges" },
        { "file": "tokenizer.py", "title": "deterministic training and compression" },
        { "file": "tokenizer.py", "title": "rank-ordered encode and round-trip" },
        { "file": "attention.py", "title": "stable softmax" },
        { "file": "attention.py", "title": "attention weights and the causal mask" },
        { "file": "sampling.py", "title": "temperature and hard greedy" },
        { "file": "sampling.py", "title": "top-k" },
        { "file": "sampling.py", "title": "top-p keeps the crossing token" },
        { "file": "sampling.py", "title": "seeded sampling is reproducible" },
        { "file": "kv_cache.py", "title": "cache append and shape" },
        { "file": "kv_cache.py", "title": "cached output is bit-exact" },
        { "file": "kv_cache.py", "title": "the cost model: linear vs quadratic" },
        { "file": "rope.py", "title": "norm and relative-position invariants" }
      ]
    },
    {
      "id": "context-caching",
      "title": "Context caching",
      "tagline": "KV cache to PagedAttention, 16 checks",
      "dir": "context-caching",
      "blurb": "Wire a KV cache into a tiny transformer, then make prefix caching, radix matching, paged KV with copy-on-write and cache-aware routing all keep the output bit-identical while the cost model collapses.",
      "files": ["kv_cache.py", "tiny_transformer.py", "prefix_cache.py", "radix_cache.py", "paged_kv_cache.py", "semantic_cache.py", "cache_router.py", "serving_demo.py"],
      "entry": "check.py",
      "checks": [
        { "file": "kv_cache.py", "title": "linear algebra helpers" },
        { "file": "kv_cache.py", "title": "KVCache append/truncate/clone" },
        { "file": "kv_cache.py", "title": "cached == uncached attention" },
        { "file": "kv_cache.py", "title": "prefill and the cost model" },
        { "file": "tiny_transformer.py", "title": "layer_norm and gelu" },
        { "file": "tiny_transformer.py", "title": "generation matches exactly" },
        { "file": "tiny_transformer.py", "title": "truncate, clone, prefix reuse" },
        { "file": "prefix_cache.py", "title": "block hashing and chaining" },
        { "file": "prefix_cache.py", "title": "matching, eviction, isolation" },
        { "file": "radix_cache.py", "title": "matching and node splitting" },
        { "file": "radix_cache.py", "title": "eviction and pinning" },
        { "file": "paged_kv_cache.py", "title": "block allocation and growth" },
        { "file": "paged_kv_cache.py", "title": "forking and copy-on-write" },
        { "file": "semantic_cache.py", "title": "exact and semantic caching" },
        { "file": "cache_router.py", "title": "cache-aware routing" },
        { "file": "serving_demo.py", "title": "capstone: identical output" }
      ]
    },
    {
      "id": "dynamo",
      "title": "Dynamo paper",
      "tagline": "quorums, vector clocks, anti-entropy, 17 checks",
      "dir": "dynamo-paper",
