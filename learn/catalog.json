      "blurb": "Capacity maths, percentile latency, SLO error budgets, root-cause diagnosis of injected faults and safe canary rollouts. The half of production that pages you at 3am, as graded checks.",
      "files": ["capacity.py", "metrics.py", "diagnose.py", "rollout.py", "deployment.py"],
